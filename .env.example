# ==========================================
# SERVIDOR
# ==========================================
PORT=3000
# Origen del frontend (CORS y enlaces).
# Vite dev: http://localhost:5173 | Frontend standalone (compose): http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Timeout de requests largos (OCR + IA + PDF), en ms.
REQUEST_TIMEOUT_MS=600000
# Timeout de renderizado de PDF con Chromium, en ms.
PUPPETEER_TIMEOUT_MS=60000

# ==========================================
# IA (Google AI Studio / Gemini)
# ==========================================
# Proveedor principal de IA: Gemini. El clasificador local por palabras clave
# (`classifyByKeywords`) es siempre el último recurso, así que la app nunca
# queda sin clasificar y no requiere infraestructura de IA local.
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo. En el plan gratuito, gemini-3.5-flash-lite es el más económico en tokens.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
# Nivel de razonamiento (minimal|low|medium|high). "minimal" gasta menos tokens de salida.
GEMINI_THINKING_LEVEL=minimal
# Tope de tokens para el flujo de cámara (Gemini maxOutputTokens).
IA_MOBILE_MAX_TOKENS=768

# ==========================================
# COLA (Redis / BullMQ)
# ==========================================
# En producción (Railway) debe ser true: el upload responde rápido y el worker
# procesa en segundo plano. También requiere un worker corriendo.
QUEUE_ENABLED=false
# Local con docker compose: redis://redis:6379
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://127.0.0.1:6379
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000

# ==========================================
# SUPABASE (backend usa la clave secreta)
# ==========================================
# URL del proyecto (ej: https://xyz123.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave secreta (service_role / secret key). NUNCA exponerla en el frontend.
SUPABASE_SECRET_KEY=
# Bucket de Storage donde se guardan los documentos.
STORAGE_BUCKET=DocumentosIA

# ==========================================
# n8n (recordatorios / correo)
# ==========================================
# URL pública y estable del webhook de n8n.
# Local con n8n en Docker: http://localhost:5678/webhook/documento-analizado
# Railway/producción: https://n8n.tudominio.com/webhook/documento-analizado
N8N_WEBHOOK_URL=http://localhost:5678/webhook/documento-analizado
# Si se define, se envía en el header X-Webhook-Token. Configura el mismo
# valor en el nodo Webhook de n8n para autenticar la llamada.
N8N_WEBHOOK_TOKEN=

# ==========================================
# CORREO / ÁREAS
# ==========================================
# Buzón de aduanas usado para derivaciones.
ADUANAS_EMAIL=aduanas.fiscalizacion@sunat.gob.pe

# ==========================================
# PANEL DE COLAS (BullMQ / bull-board)
# ==========================================
# Habilita el panel de BullMQ en QUEUE_DASHBOARD_BASE_PATH.
QUEUE_DASHBOARD_ENABLED=false
# Ruta base del panel (ej: /admin/queues).
QUEUE_DASHBOARD_BASE_PATH=/admin/queues
# Token opcional para proteger el panel en producción.
# Si se define, se valida mediante el header Authorization: Bearer <token>.
QUEUE_DASHBOARD_TOKEN=
