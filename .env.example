# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# IA (Google AI Studio / Gemini + Ollama)
# ==========================================
# Proveedor principal: gemini | ollama | auto (auto: Gemini si hay clave, si no Ollama)
IA_PROVIDER=auto
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo. En el plan gratuito, gemini-3.5-flash-lite es el más económico en tokens.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
# Nivel de razonamiento (minimal|low|medium|high). "minimal" gasta menos tokens de salida.
GEMINI_THINKING_LEVEL=minimal
# Si Gemini falla, intentar Ollama antes de caer al clasificador local
OLLAMA_FALLBACK=true

# Ollama (IA local, respaldo)
OLLAMA_HOST=http://192.168.18.10:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000

# Cola opcional para procesar documentos con Redis/BullMQ
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
OLLAMA_CONCURRENCY=1

# Correo (Nodemailer - Edu lo usa en Avance 1/2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM="Gestor Documentos <no-reply@empresa.com>"

# ==========================================
# Supabase Configuration
# ==========================================
# URL del proyecto (ej: https://xyz123.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon key) - Usada solo en el Frontend
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_clave_anon_aqui

# Clave secreta (service_role key) - Usada SOLO en el Backend
# ¡NUNCA compartas esta clave ni la expongas en el frontend!
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_clave_secret_aqui

# URL para verificar tokens JWT (opcional, pero recomendado para validación)
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/jwks
